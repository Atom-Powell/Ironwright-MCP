{
  "name": "@ironwright/repo-reconciliation-mcp",
  "version": "0.1.0",
  "description": "MCP Server by Ironwright (Adam Powell).",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test:errors": "vitest run .errors.test",
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "setup": "tsx src/setup/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atom-Powell/Ironwright-MCP.git"
  },
  "keywords": [],
  "author": "",
  "license": "Elastic-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Atom-Powell/Ironwright-MCP/issues"
  },
  "homepage": "https://github.com/Atom-Powell/Ironwright-MCP#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
